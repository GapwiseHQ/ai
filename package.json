{
  "name": "gapwise-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Permissioned, provider-neutral MCP integration service for Gapwise.",
  "license": "MIT",
  "author": "Andrew Muratov",
  "homepage": "https://ai.gapwise.ca",
  "repository": {
    "type": "git",
    "url": "https://github.com/GapwiseHQ/ai.git"
  },
  "bugs": {
    "url": "https://github.com/GapwiseHQ/ai/issues"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check:cost-model": "node scripts/check-cost-model.mjs",
    "audit:production": "node scripts/audit-production-dependencies.mjs",
    "check": "npm run scan:secrets && npm run check:cost-model && npm run contract:check && npm run typecheck && npm test && npm run build",
    "contract:generate": "node scripts/mcp-surface-contract.mjs --write",
    "contract:check": "node scripts/mcp-surface-contract.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "mcp-handler": "2.2.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
